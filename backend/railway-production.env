# Variables de entorno para producción en Railway
# Copia estas variables al dashboard de Railway

# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# BASE DE DATOS (Railway las configura automáticamente)
# ============================================
# Estas variables son configuradas automáticamente por Railway cuando conectas una base de datos MySQL
# DB_HOST= (configurado por Railway)
# DB_USER= (configurado por Railway)
# DB_PASSWORD= (configurado por Railway)
# DB_NAME= (configurado por Railway)
# DB_PORT=3306

# ============================================
# SECRETOS DE SEGURIDAD
# ============================================
JWT_SECRET=c62721f7ac860e7dbda18619781760c4210d67b2e7d5fd6c86cbac19ce6d7babf55d6ca852f5a93aa9205e3dcacfd4e354683635d6d37543ba05d85cfd7cffa5
COOKIE_SECRET=73914efe2ed29f8840459a89637d9d9f4b942b4c2040473ea01d9f6c0ce0470ffcbbfcd7243896b0b643110c32f5bfe49a700b4bc76b108bb0456f9004d2835f

# ============================================
# CONFIGURACIÓN DE EMAIL CON BREVO
# ============================================
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_api_key_de_brevo

# ============================================
# CONFIGURACIÓN DE URLS
# ============================================
# Reemplaza con tu URL real de Railway
CORS_ORIGIN=https://sabor-production.up.railway.app
FRONTEND_URL=https://sabor-production.up.railway.app

# ============================================
# CONFIGURACIÓN OPCIONAL
# ============================================
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=sabor-app
JWT_AUDIENCE=sabor-users
LOG_LEVEL=info

# ============================================
# CONFIGURACIÓN DE PAYU
# ============================================
PAYU_API_LOGIN=pRRXKOl8ikMmt9u
PAYU_API_KEY=4Vj8eK4rloUd272L48hsrarnUA
PAYU_MERCHANT_ID=508029
PAYU_ACCOUNT_ID=512321
PAYU_TEST_MODE=true

# ============================================
# CONFIGURACIÓN DE RAILWAY
# ============================================
# Railway configura automáticamente estas variables
# RAILWAY_ENVIRONMENT=production
# RAILWAY_STATIC_URL= (tu URL de Railway)

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS MEJORADA
# ============================================
# Estas variables ayudan con la conexión en producción
DB_CONNECT_TIMEOUT=30000
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000
DB_SSL_MODE=require

# ============================================
# INSTRUCCIONES:
# ============================================
# 1. Ve a Railway Dashboard > Tu Proyecto > Variables
# 2. Agrega cada variable con su valor correspondiente
# 3. Para EMAIL_USER: usa tu cuenta de Gmail
# 4. Para EMAIL_PASSWORD: usa la contraseña de aplicación de Gmail
# 5. Para CORS_ORIGIN y FRONTEND_URL: usa la URL que Railway te asigne
# 6. Las variables de DB las configura Railway automáticamente
# 7. Después de configurar, ejecuta el diagnóstico: npm run db:diagnostic
