# Configuración de la Base de Datos
DB_HOST=localhost
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=sabor_db_1
DB_PORT=3306

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de JWT
JWT_SECRET=tu_super_secreto_jwt_muy_largo_y_seguro_aqui
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=sabor-app
JWT_AUDIENCE=sabor-users

# Configuración de Cookies
COOKIE_SECRET=tu_secreto_para_cookies_muy_seguro

# Configuración de CORS
CORS_ORIGIN=http://localhost:5173

# Configuración de Email (para notificaciones)
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion

# URL del Frontend
FRONTEND_URL=http://localhost:5173

# Configuración de Logging
LOG_LEVEL=debug

# Configuración de MercadoPago (opcional)
MERCADOPAGO_ACCESS_TOKEN=TEST-tu_token_de_mercadopago

