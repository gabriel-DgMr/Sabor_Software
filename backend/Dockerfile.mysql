# Dockerfile para MySQL con inicialización automática de Migrations
# Este contenedor crea la base de datos usando los archivos de migration

FROM mysql:8.0

# Configurar variables de entorno por defecto
ENV MYSQL_ROOT_PASSWORD=rootpassword
ENV MYSQL_DATABASE=sabor_db
ENV MYSQL_USER=sabor_user
ENV MYSQL_PASSWORD=sabor_password

# Configurar MySQL para aceptar conexiones desde cualquier host
ENV MYSQL_ROOT_HOST=%

# Copiar todos los archivos SQL de migrations para inicialización automática
# MySQL ejecuta automáticamente todos los archivos SQL en /docker-entrypoint-initdb.d/ en orden alfabético
COPY migrations/*.sql /docker-entrypoint-initdb.d/

# Copiar configuración personalizada de MySQL
COPY mysql/conf.d/mysql.cnf /etc/mysql/conf.d/

# Exponer puerto MySQL
EXPOSE 3306

# Etiquetas para identificación
LABEL maintainer="Sistema Sabor"
LABEL description="MySQL container with Sabor database migrations"
LABEL version="1.0" 