{
  "info": {
    "name": "Sabor API Collection",
    "description": "Colección completa de la API de Sabor con endpoints organizados por recursos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "sabor-api-v1"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh token if needed",
          "if (pm.globals.get('tokenExpiry') && new Date() > new Date(pm.globals.get('tokenExpiry'))) {",
          "    pm.globals.unset('authToken');",
          "    console.log('Token expired, please login again');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string",
      "description": "Base URL del servidor API"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "JWT Token para autenticación"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string",
      "description": "ID del usuario actual"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string",
      "description": "ID de producto para testing"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string",
      "description": "ID de categoría para testing"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string",
      "description": "ID de pedido para testing"
    },
    {
      "key": "reservationId",
      "value": "",
      "type": "string",
      "description": "ID de reserva para testing"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "description": "Endpoints de autenticación y gestión de usuarios",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"juan@example.com\",\n  \"telefono\": \"1234567890\",\n  \"contraseña\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registra un nuevo usuario en el sistema"
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.globals.set('authToken', response.token);",
                  "    pm.globals.set('userId', response.usuario.id);",
                  "    ",
                  "    // Calculate token expiry (assuming 1 hour)",
                  "    const expiry = new Date();",
                  "    expiry.setHours(expiry.getHours() + 1);",
                  "    pm.globals.set('tokenExpiry', expiry.toISOString());",
                  "    ",
                  "    console.log('Login successful, token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\",\n  \"contraseña\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Autentica un usuario y devuelve un JWT token"
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-email?token=verification_token_here",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-email"],
              "query": [
                {
                  "key": "token",
                  "value": "verification_token_here"
                }
              ]
            },
            "description": "Verifica el email del usuario con el token enviado"
          },
          "response": []
        },
        {
          "name": "Forgot Password",
