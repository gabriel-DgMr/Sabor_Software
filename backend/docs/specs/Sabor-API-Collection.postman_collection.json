              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Solicita un token para restablecer contraseña"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
