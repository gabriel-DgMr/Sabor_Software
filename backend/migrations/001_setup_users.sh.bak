#!/bin/bash

# =============================================================================
# CONFIGURACIÓN DE USUARIOS - SISTEMA SABOR
# =============================================================================
# Script que configura usuarios de MySQL usando variables de entorno
# Se ejecuta después de la inicialización básica de MySQL
# =============================================================================

set -e

echo "🔧 Configurando usuarios de MySQL con variables de entorno..."

# Verificar que las variables de entorno estén definidas
if [ -z "$MYSQL_ROOT_PASSWORD" ] || [ -z "$MYSQL_USER" ] || [ -z "$MYSQL_PASSWORD" ]; then
    echo "❌ ERROR: Variables de entorno MySQL no están definidas correctamente"
    echo "   MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-'NO DEFINIDA'}"
    echo "   MYSQL_USER: ${MYSQL_USER:-'NO DEFINIDA'}"
    echo "   MYSQL_PASSWORD: ${MYSQL_PASSWORD:-'NO DEFINIDA'}"
    exit 1
fi

echo "📋 Configurando usuarios:"
echo "   - Root: root@% con contraseña de variable de entorno"
echo "   - Usuario aplicación: ${MYSQL_USER}@% con contraseña de variable de entorno"
echo "   - Base de datos: ${MYSQL_DATABASE:-sabor_db}"

# Ejecutar configuración de usuarios usando variables de entorno
mysql -u root -p"${MYSQL_ROOT_PASSWORD}" <<EOF

-- =============================================================================
-- CONFIGURACIÓN DE USUARIOS CON VARIABLES DE ENTORNO
-- =============================================================================

-- Asegurar que el usuario root tenga permisos desde cualquier host
-- Nota: Esto es seguro solo para desarrollo
UPDATE mysql.user SET Host='%' WHERE User='root' AND Host='localhost';
FLUSH PRIVILEGES;

-- Crear o actualizar usuario de aplicación con permisos desde cualquier host
DROP USER IF EXISTS '${MYSQL_USER}'@'%';
CREATE USER '${MYSQL_USER}'@'%' IDENTIFIED WITH mysql_native_password BY '${MYSQL_PASSWORD}';
GRANT ALL PRIVILEGES ON ${MYSQL_DATABASE}.* TO '${MYSQL_USER}'@'%';
GRANT SELECT ON mysql.* TO '${MYSQL_USER}'@'%';
FLUSH PRIVILEGES;

-- Crear usuario root adicional para conexiones externas
DROP USER IF EXISTS 'root'@'%';
CREATE USER 'root'@'%' IDENTIFIED WITH mysql_native_password BY '${MYSQL_ROOT_PASSWORD}';
GRANT ALL PRIVILEGES ON *.* TO 'root'@'%' WITH GRANT OPTION;
FLUSH PRIVILEGES;

-- Verificar usuarios creados
SELECT User, Host, plugin FROM mysql.user WHERE User IN ('root', '${MYSQL_USER}');

-- Insertar log de configuración
USE ${MYSQL_DATABASE};
INSERT INTO migration_history (migration_file, status) VALUES 
('001_setup_users.sh', 'success');

EOF

echo "✅ Configuración de usuarios completada exitosamente"
echo "🔐 Usuarios configurados:"
echo "   - root@% (contraseña: ${MYSQL_ROOT_PASSWORD})"
echo "   - ${MYSQL_USER}@% (contraseña: ${MYSQL_PASSWORD})"
echo "   - Base de datos: ${MYSQL_DATABASE}"

echo "🎯 Ahora puedes conectarte desde DBeaver usando:"
echo "   Host: localhost"
echo "   Puerto: 3306"
echo "   Database: ${MYSQL_DATABASE}"
echo "   Usuario: ${MYSQL_USER} o root"
echo "   Contraseña: Según tu archivo .env" 