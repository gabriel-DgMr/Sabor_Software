# Configuración de la Base de Datos - PRODUCCIÓN
DB_HOST=your_production_db_host
DB_USER=your_production_db_user
DB_PASSWORD=your_production_db_password
DB_NAME=sabor_production_db
DB_PORT=3306

# Configuración del Servidor - PRODUCCIÓN
PORT=3000
NODE_ENV=production

# Configuración de JWT - PRODUCCIÓN
# IMPORTANTE: Genera un secreto fuerte y único para producción
JWT_SECRET=your_super_secure_production_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=sabor-app
JWT_AUDIENCE=sabor-users

# Configuración de Cookies - PRODUCCIÓN
# IMPORTANTE: Genera un secreto fuerte y único para producción
COOKIE_SECRET=your_super_secure_production_cookie_secret_at_least_32_characters

# Configuración de CORS - PRODUCCIÓN
CORS_ORIGIN=https://your-production-domain.com

# Configuración de Email - PRODUCCIÓN
EMAIL_USER=your_production_email@gmail.com
EMAIL_PASSWORD=your_production_app_password

# URL del Frontend - PRODUCCIÓN
FRONTEND_URL=https://your-production-domain.com

# URL del Backend - PRODUCCIÓN (CRÍTICO para PayU)
BACKEND_URL=https://your-production-backend-domain.com

# Configuración de Logging - PRODUCCIÓN
LOG_LEVEL=info

# Configuración de PayU - PRODUCCIÓN
# IMPORTANTE: Obtén estas credenciales reales de tu cuenta PayU de producción
PAYU_API_LOGIN=your_production_payu_api_login
PAYU_API_KEY=your_production_payu_api_key
PAYU_MERCHANT_ID=your_production_merchant_id
PAYU_ACCOUNT_ID=your_production_account_id
PAYU_TEST_MODE=false

# Configuraciones adicionales para producción
TRUST_PROXY=1
SESSION_SECURE=true
COMPRESSION_ENABLED=true
RATE_LIMIT_ENABLED=true
