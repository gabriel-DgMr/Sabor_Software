    "docker:build": "docker-compose build mysql-sabor",
    "docker:logs": "docker-compose logs -f mysql-sabor",
    "docker:ps": "docker-compose ps",
    "docker:mysql": "docker exec -it sabor-mysql mysql -u sabor_user -p sabor_db_1"
