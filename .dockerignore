# Node modules
node_modules/
frontend/node_modules/
backend/node_modules/

# Build outputs
frontend/dist/
backend/dist/

# Development files
.git/
.gitignore
.env
.env.*
!.env.production.example
!env.production.example

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/
backend/logs/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm
node_modules/.cache
frontend/node_modules/.cache
backend/node_modules/.cache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# Temporary folders
tmp/
temp/
backend/temp/

# Documentation
*.md
!README.md

# Test files
test/
tests/
**/*.test.js
**/*.spec.js

# Development tools
nodemon.json
.eslintrc*
.prettierrc*

# Docker files (avoid recursive Docker builds)
Dockerfile*
docker-compose*.yml

# Backup files
backup/
*.backup

# Uploads (will be mounted as volume)
uploads/
backend/public/uploads/

# Allow product images to be copied to Docker
!public/uploads/productos/

# SSL certificates (will be mounted separately)
ssl/
*.pem
*.key
*.crt
